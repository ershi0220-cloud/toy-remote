{
  "name": "ter_guzhe_scene_v1",
  "version": 2,
  "mode": "dual_channel_timeline",
  "note": "Story-derived rhythm preset. Narrative locations are treated as fiction only; execution follows rhythm/intensity, not scene geography.",
  "channels": {
    "inner": {"min": 1, "max": 6},
    "outer": {"min": 1, "max": 6}
  },
  "safety": {
    "emergency_stop": true,
    "stop_words": ["red"],
    "triple_tap_stop": true,
    "on_stop": {"inner": "off", "outer": "off"}
  },
  "phases": [
    {
      "id": "intro",
      "steps": [
        {"seconds": 8, "inner": 1, "outer": "off"},
        {"seconds": 4, "inner": 3, "outer": "off"},
        {"seconds": 8, "inner": 1, "outer": "off"}
      ]
    },
    {
      "id": "walk_rhythm",
      "repeat": 4,
      "steps": [
        {"seconds": 10, "inner": 2, "outer": "off"},
        {"seconds": 1, "inner": 2, "outer": 4}
      ]
    },
    {
      "id": "main_cycle",
      "repeat": 3,
      "steps": [
        {"seconds": 10, "inner": 2, "outer": 1},
        {"seconds": 4, "inner": 4, "outer": 3},
        {"seconds": 4, "inner": "off", "outer": "off"},
        {"seconds": 7, "inner": 3, "outer": "off"}
      ]
    },
    {
      "id": "ramp",
      "steps": [
        {"seconds": 6, "inner": 4, "outer": 3},
        {"seconds": 4, "inner": 5, "outer": 4},
        {"seconds": 6, "inner": 2, "outer": 1}
      ]
    },
    {
      "id": "high_intensity",
      "steps": [
        {"seconds": 3, "inner": "off", "outer": "off"},
        {"seconds": 5, "inner": 6, "outer": 5},
        {"seconds": 8, "inner": 4, "outer": 3},
        {"seconds": 6, "inner": 5, "outer": 4}
      ]
    },
    {
      "id": "cooldown",
      "steps": [
        {"seconds": 15, "inner": 2, "outer": "off"},
        {"seconds": 10, "inner": 1, "outer": "off"},
        {"seconds": 1, "inner": "off", "outer": "off"}
      ],
      "end": true
    }
  ],
  "current_toy_watch": {
    "command_file": "command.json",
    "known_sequence_shape": {
      "action": "sequence",
      "target": "inner|outer",
      "steps": "level:seconds,level:seconds,..."
    },
    "compatibility": "partial",
    "reason": "The current watcher is known to sequence one target at a time, so this dual-channel timeline remains a preset until dual-channel parsing is added."
  }
}
